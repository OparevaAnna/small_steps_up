{
  "name": "backend",
  "version": "1.0.0",
  "description": "Small Steps Up — backend API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/runMigrations.ts",
    "seed": "tsx scripts/runSeeds.ts",
    "db:setup": "npm run migrate && npm run seed",
